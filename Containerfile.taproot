# Taproot image: the server binary with the dashboard build embedded.
#
#   docker build -f Containerfile.taproot \
#     --build-arg VERSION="$(git describe --tags --match 'taproot-v*' --always)" \
#     --build-arg COMMIT="$(git rev-parse --short HEAD)" \
#     --build-arg BUILD_DATE="$(date -u +%Y-%m-%dT%H:%M:%SZ)" -t taproot .
#
# Mount config.yaml and taproot.yaml as a directory, not as single files:
# backup restores replace them by rename, which fails on a single-file bind
# mount. The default command expects /taproot/config/config.yaml. Set TZ for
# the backup schedule's local time; the image does not pick a zone.

# Matches packageManager in web/package.json.
ARG BUN_VERSION=1.4.4
# Matches the Rust toolchain of the codec job in .github/workflows/ci.yml.
ARG RUST_VERSION=1.99
# Matches the go line in go.mod, which CI builds, tests, and scans with.
ARG GO_VERSION=1.26.10
# Each FROM pins its image to the digest of the tag's multi-arch index, which
# covers linux/amd64 and linux/arm64. Change a version only with its digest:
# with a digest present, the tag is not used to pick the image, so each stage
# first checks that its toolchain is the version its ARG names.

FROM docker.io/oven/bun:${BUN_VERSION}@sha256:1d22548f177f4ff38e0c15baa3c2c46c6c2060ba2d1bc573bb4720b407548f1d AS web
ARG BUN_VERSION
RUN v="$(bun --version)"; [ "$v" = "${BUN_VERSION}" ] \
	|| { echo "the oven/bun digest has bun $v, not BUN_VERSION=${BUN_VERSION}" >&2; exit 1; }
WORKDIR /src
COPY web/package.json web/bun.lock /deps/
RUN cd /deps && bun install --frozen-lockfile
COPY web ./web
COPY scripts/taproot/build-web.sh ./scripts/taproot/build-web.sh
COPY internal/taproot/web/dist ./internal/taproot/web/dist
ARG VERSION=dev
# A node_modules or dist from the build context belongs to another platform.
RUN rm -rf web/node_modules web/dist \
	&& mv /deps/node_modules web/node_modules \
	&& VERSION="${VERSION}" bash scripts/taproot/build-web.sh

# The request-log codec library (Lepton, preflate, zstd), linked statically
# into the server with the taproot_codecs build tag.
FROM docker.io/library/rust:${RUST_VERSION}-slim-bookworm@sha256:f2c004e3d2d8b547e8cf7ffbc29205385f4e71d23e53e4e383065db5e9f822cd AS codec
ARG RUST_VERSION
RUN v="$(rustc --version)"; case "$v" in "rustc ${RUST_VERSION}."* | "rustc ${RUST_VERSION} "*) ;; \
	*) echo "the rust digest has $v, not RUST_VERSION=${RUST_VERSION}" >&2; exit 1 ;; esac
WORKDIR /src
COPY internal/taproot/reqlog/codec/native/Cargo.toml internal/taproot/reqlog/codec/native/Cargo.lock ./
# Modified crates that a [patch.crates-io] entry in Cargo.toml points at.
COPY internal/taproot/reqlog/codec/native/patches ./patches
RUN mkdir src && touch src/lib.rs && cargo fetch --locked
COPY internal/taproot/reqlog/codec/native/src ./src
RUN cargo build --release --locked --offline

FROM docker.io/library/golang:${GO_VERSION}-bookworm@sha256:5de7c99eb78ca5e515a4c340235d0955ec5964a5071c492c15503d7c267da473 AS build
ARG GO_VERSION
RUN v="$(go env GOVERSION)"; [ "$v" = "go${GO_VERSION}" ] \
	|| { echo "the golang digest has $v, not GO_VERSION=${GO_VERSION}" >&2; exit 1; }
WORKDIR /src
RUN apt-get update && apt-get install -y --no-install-recommends build-essential git && rm -rf /var/lib/apt/lists/*
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# The dashboard is index.html plus hashed chunks; drop any host build's chunks first.
RUN rm -rf internal/taproot/web/dist
COPY --from=web /src/internal/taproot/web/dist ./internal/taproot/web/dist
# A host build of the codec library may target another glibc; use the stage's.
RUN rm -rf internal/taproot/reqlog/codec/native/target
COPY --from=codec /src/target/release/libtaproot_codec.a ./internal/taproot/reqlog/codec/native/target/release/libtaproot_codec.a
ARG VERSION=dev
ARG COMMIT=none
ARG BUILD_DATE=unknown
RUN set -eu; \
	ldflags="-s -w -X 'main.Version=${VERSION}' -X 'main.Commit=${COMMIT}' -X 'main.BuildDate=${BUILD_DATE}'"; \
	mkdir -p /out; \
	CGO_ENABLED=1 GOOS=linux go build -buildvcs=false -tags taproot_codecs -ldflags="${ldflags}" -o /out/taproot ./cmd/server; \
	chmod 0755 /out/*

FROM docker.io/library/debian:bookworm-slim@sha256:734a72b3d6142a71993b4bc580ca01d8ca687f77a2c422d96a961d3376b179bc
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata && rm -rf /var/lib/apt/lists/*
COPY --from=build /out/ /taproot/
COPY config.example.yaml LICENSE THIRD_PARTY_NOTICES.md /taproot/
# The dashboard's license, at the path THIRD_PARTY_NOTICES.md links to, and
# the GNU licenses of the LGPL crates in the codec library.
COPY web/LICENSE /taproot/web/LICENSE
COPY licenses /taproot/licenses
RUN chmod -R a+rX,go-w /taproot/config.example.yaml /taproot/LICENSE /taproot/THIRD_PARTY_NOTICES.md /taproot/web /taproot/licenses
ARG VERSION=dev
ARG COMMIT=none
LABEL org.opencontainers.image.title="taproot" \
	org.opencontainers.image.description="Pools Claude and Codex subscription accounts behind one endpoint on your tailnet, with a dashboard for quota, usage, request logs, and backups." \
	org.opencontainers.image.source="https://github.com/265866/taproot" \
	org.opencontainers.image.version="${VERSION}" \
	org.opencontainers.image.revision="${COMMIT}" \
	org.opencontainers.image.licenses="MIT"
# No USER, on purpose. Under rootless Podman the default user namespace maps
# container root to the host user who owns the bind-mounted data directory,
# so taproot reads and writes it as that user. A fixed non-root USER would map
# to a subordinate uid that cannot read the 0600 config and credential files
# there. Under rootful Docker, run with --user "$(id -u):$(id -g)" instead;
# the image needs nothing writable outside the data directory.
WORKDIR /taproot
EXPOSE 8317
ENTRYPOINT ["/taproot/taproot"]
CMD ["--config", "/taproot/config/config.yaml"]
