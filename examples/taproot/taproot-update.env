# Settings for scripts/taproot/taproot-update. Copy to
# ~/.config/taproot-update.env. Lines are KEY=VALUE; the script reads them
# itself and runs nothing in this file.

# The release line to follow. 0.2 brings patch releases (0.2.1, 0.2.2) and
# never a new minor version, which may need a config change; move to the next
# line by hand after reading its release notes.
TAPROOT_IMAGE=ghcr.io/265866/taproot
TAPROOT_TRACK=0.2

# The quadlet in examples/taproot/taproot.container: its unit, its
# ContainerName=, and the local tag it runs. That quadlet runs
# ghcr.io/265866/taproot:0.2 until you set its Image= to TAPROOT_LOCAL_TAG, add
# Pull=never, and run the updater once, which verifies, pulls, and tags the
# release ("Automatic updates (optional)" in README.md). The image the updater
# replaces is kept as localhost/taproot:previous.
TAPROOT_UNIT=taproot.service
TAPROOT_CONTAINER=taproot
TAPROOT_LOCAL_TAG=localhost/taproot:current

# Where taproot answers once it serves: the address in the quadlet's
# PublishPort=. A new release that is not running and answering here within
# the timeout (seconds) is rolled back.
TAPROOT_HEALTH_URL=http://100.64.0.1:8317/healthz
TAPROOT_HEALTH_TIMEOUT=120
