# Git and GitHub folders
.git
.github

# Docker and CI/CD related files
.dockerignore
.gitignore

# Documentation and license
docs
README.md
LICENSE

# Runtime data: configuration, credentials, the database, request logs, and
# backups are mounted at run time and must never be baked into an image.
# Patterns without a slash match at the context root only, so examples/ and
# internal/taproot/ stay in.
data
taproot
auths
logs
conv
config.yaml
taproot.yaml
.env
.env.*
plugins
static
pgstore
gitstore
objectstore
temp
refs
**/*.log
**/*.db
**/*.db-wal
**/*.db-shm
**/*.tar.zst

# Host build output; the image builds its own.
web/node_modules
web/dist

# Development/editor
bin
.vscode
.claude
.codex
.codex-worktrees
.gemini
.serena
.agent
.agents
.antigravitycli
.opencode
.idea
.junie
.worktrees
.bmad
_bmad
_bmad-output
