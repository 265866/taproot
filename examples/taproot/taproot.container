# Rootless Podman quadlet for taproot.
#
# 1. Pull the release line to follow and tag it as the image this unit runs.
#    Following 0.2 brings patch releases (0.2.1, 0.2.2) but never a new minor
#    version, which may need a config change:
#      podman pull ghcr.io/265866/taproot:0.2
#      podman tag ghcr.io/265866/taproot:0.2 localhost/taproot:current
#    "Automatic updates (optional)" in README.md shows how to check the
#    signature first, or how taproot-update does this whole step for you.
#    To run your own build instead:
#      podman build -f Containerfile.taproot -t localhost/taproot:current .
# 2. mkdir -p ~/taproot/data. On its first start, taproot writes config.yaml
#    and taproot.yaml there; to use your own, copy them from examples/taproot.
# 3. Replace 100.64.0.1 below with this host's address from `tailscale ip -4`.
# 4. Copy this file to ~/.config/containers/systemd/taproot.container, then run
#    systemctl --user daemon-reload && systemctl --user start taproot
#    and `loginctl enable-linger "$USER"` so it runs without a login session.
# 5. Find the setup code with `journalctl --user -u taproot | grep 'setup code'`,
#    open the URL in that line on the device you manage taproot from, and
#    enter the code.
#
# To update by hand, pull and tag the new release as in step 1, then run
# systemctl --user restart taproot. To update automatically instead, use
# scripts/taproot/taproot-update with taproot-update.timer from this directory
# ("Automatic updates (optional)" in README.md). It moves the local tag only to
# a signed release, and rolls back when the new release fails to start.
#
# Run it as your own user, not root, and without User= or UserNS=: Podman maps
# the container's root to your user, which owns the 0600 files in the data
# directory.

[Unit]
Description=taproot (tailnet-only AI proxy and dashboard)
Wants=network-online.target
After=network-online.target

[Container]
Image=localhost/taproot:current
Pull=never
ContainerName=taproot
Environment=TZ=Etc/UTC
# The root filesystem is read-only, so everything taproot writes goes to the
# data directory.
Environment=HOME=/taproot/config/home
Environment=XDG_CACHE_HOME=/taproot/config/cache
Environment=WRITABLE_PATH=/taproot/config
# config.yaml, taproot.yaml, auths/, and taproot's database, request logs, and
# backups. Mount the directory, not single files: restoring a backup replaces
# files by rename. Add :Z on an SELinux host.
Volume=%h/taproot/data:/taproot/config
# The access guard identifies callers through the host's tailscaled.
Volume=/var/run/tailscale/tailscaled.sock:/var/run/tailscale/tailscaled.sock
# pasta keeps each caller's source address, which the access guard depends on.
Network=pasta
# Publish on the host's Tailscale address only. Never 0.0.0.0, a LAN address,
# or 127.0.0.1: loopback callers are admins.
PublishPort=100.64.0.1:8317:8317/tcp
ReadOnly=true
DropCapability=all
NoNewPrivileges=true
LogDriver=journald

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=120
TimeoutStopSec=45
UMask=0077

[Install]
WantedBy=default.target
